<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:SonicPad.UI.Views"
        xmlns:vm="clr-namespace:SonicPad.ViewModels"
        xmlns:system="clr-namespace:System;assembly=System.Runtime"
        mc:Ignorable="d" d:DesignWidth="1240" d:DesignHeight="720"
        x:Class="SonicPad.MainWindow"
        Title="SonicPad"
        Width="{Binding Settings.ApplicationUiSettings.WindowWidth, Mode=OneTime}"
        Height="{Binding Settings.ApplicationUiSettings.WindowHeight, Mode=OneTime}"
        MinWidth="500"
        MinHeight="400"
        x:Name="RootWindow"
        x:DataType="vm:SonicPadViewModel">

    <Window.Resources>
        <system:Double x:Key="CategoryMaxHeightRatio">0.33</system:Double>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="GridSplitter:pointerover Rectangle">
            <Setter Property="Fill" Value="{DynamicResource AccentFocusBrush}" />
        </Style>
    </Window.Styles>

    <Design.DataContext>
        <vm:SonicPadViewModel />
    </Design.DataContext>
    <!-- Main Workspace: Resizable Sidebar on Left, Content Grid on Right -->
    <Grid x:Name="MainWorkspaceGrid"
          Background="{DynamicResource WindowBackgroundBrush}" ClipToBounds="False">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" MinWidth="160" MaxWidth="500" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <views:CategorySidebarView Grid.Column="0" />

        <!-- Resizer Splitter with 1px border line and 5px hit-test zone -->
        <GridSplitter Grid.Column="1"
                      Width="5"
                      Background="Transparent"
                      Cursor="SizeWestEast"
                      ResizeDirection="Columns">
            <GridSplitter.Template>
                <ControlTemplate>
                    <Border Background="Transparent" Width="5">
                        <Rectangle Width="1"
                                   Fill="{DynamicResource PadBorderBrush}"
                                   HorizontalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <!-- Right Side: SonicPad Grid, Settings Panel, Bottom Bar -->
        <Grid Grid.Column="2" RowDefinitions="2,*,Auto,Auto">
            <!-- Reserve the slot even when hidden to keep pad positions stable. -->
            <ProgressBar Grid.Row="0" Height="2" MinHeight="0"
                         Minimum="0" Maximum="1"
                         Value="{Binding LoadingProgress}"
                         IsVisible="{Binding IsLoadingSounds}"
                         IsIndeterminate="{Binding IsScanningSounds}"
                         Foreground="{DynamicResource AccentFocusBrush}" />
            <views:SonicPadGridView Grid.Row="1"
                                      BorderThickness="0,0,0,1"
                                      BorderBrush="{DynamicResource PadBorderBrush}" />

            <views:SettingsPanelView Grid.Row="2"
                                     IsVisible="{Binding SettingsVisible}"
                                     BorderThickness="0,0,0,1"
                                     BorderBrush="{DynamicResource PadBorderBrush}" />

            <views:BottomBarView Grid.Row="3" />
        </Grid>
    </Grid>

</Window>