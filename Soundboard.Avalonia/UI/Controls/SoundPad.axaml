<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:discovery="clr-namespace:Soundboard.Avalonia.Discovery"
             xmlns:avalonia="clr-namespace:Soundboard.Avalonia"
             xmlns:converters="clr-namespace:Soundboard.Avalonia.UI.Converters"
             mc:Ignorable="d" d:DesignWidth="200" d:DesignHeight="200"
             x:Class="Soundboard.Avalonia.UI.Controls.SoundPad"
             x:DataType="discovery:SoundModel"
             PointerEntered="InputElement_OnPointerEntered"
             PointerExited="InputElement_OnPointerExited"
             SizeChanged="Control_OnSizeChanged"
             Cursor="Hand"
             ClipToBounds="False">
    <Design.DataContext>
        <discovery:SoundModel />
    </Design.DataContext>


    <UserControl.Styles>
        <Style Selector="Border.glow">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.glow.playing">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.02" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border.progress">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.progress.playing">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.02" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="TextBlock.pad-footer">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="FontFeatures" Value="tnum" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>

        <Style Selector="Rectangle.playhead-layer">
            <Setter Property="Width" Value="{StaticResource PlayheadSize}" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </UserControl.Styles>

    <Panel ClipToBounds="False">

        <!-- Glow Underlay -->
        <Border Classes="glow"
                Classes.playing="{Binding IsPlaying}"
                ClipToBounds="False"
                IsHitTestVisible="False"
                Background="{DynamicResource PadSurfaceBrush}"
                CornerRadius="{DynamicResource PadOuterCornerRadius}"
                Effect="{Binding Category.BackgroundBrush, Converter={StaticResource OuterGlowConverter}, ConverterParameter='Pad'}" />

        <!-- Main Pad Surface -->
        <Border ClipToBounds="False"
            Background="{DynamicResource PadSurfaceBrush}"
            CornerRadius="{DynamicResource PadOuterCornerRadius}"
            BorderThickness="{DynamicResource PadBorderThickness}"
            BorderBrush="{DynamicResource PadBorderBrush}">
            <Border.Transitions>
                <Transitions>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.15" Easing="CubicEaseInOut" />
                </Transitions>
            </Border.Transitions>
            <Border.BoxShadow>
                <MultiBinding Converter="{StaticResource ShadowConverter}">
                    <Binding Path="Category.BackgroundBrush" />
                    <Binding Source="{StaticResource PadAccentThickness}" />
                    <Binding Source="{StaticResource PadAccentCornerRadius}" />
                    <Binding Path="IsPlaying" />
                </MultiBinding>
            </Border.BoxShadow>

            <Grid>

                <!-- Content -->
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,*,Auto"
                      HorizontalAlignment="Stretch"
                      Margin="{DynamicResource PadInnerPadding}">

                    <!-- Category Name -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                               Text="{Binding Category.Name}"
                               Foreground="{Binding Category.BackgroundBrush}"
                               FontSize="{DynamicResource PadCategoryFontSize}"
                               FontWeight="DemiBold" />
                    <Border Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            x:Name="TitleTextBoxBounds"
                            UseLayoutRounding="False"
                            Padding="0 8"
                            ClipToBounds="True">

                        <!-- Sound Name -->
                        <ScrollViewer x:Name="TitleScroll"
                                      UseLayoutRounding="False"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Hidden">
                            <TextBlock x:Name="TitleTextBlock"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Top"
                                       UseLayoutRounding="False"
                                       TextOptions.BaselinePixelAlignment="Unaligned"
                                       TextOptions.TextRenderingMode="SubpixelAntialias"
                                       Text="{Binding Name}"
                                       Foreground="{DynamicResource TextPrimaryBrush}">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </ScrollViewer>
                    </Border>

                    <!-- Duration -->
                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Classes="pad-footer"
                               Text="{Binding Duration, StringFormat='{}{0:m\\:ss\\.ff}'}"
                               FontSize="{DynamicResource PadDurationFontSize}"
                               HorizontalAlignment="Left" />

                    <!-- Number -->
                    <TextBlock Grid.Row="2" Grid.Column="1"
                               Classes="pad-footer"
                               Text="{Binding Index, StringFormat='#{0:D2}'}"
                               FontSize="{DynamicResource PadNumberFontSize}"
                               HorizontalAlignment="Right" />

                </Grid>


                <!-- Playhead and progress -->
                <Border Classes="progress"
                        Classes.playing="{Binding IsPlaying}"
                        ClipToBounds="True"
                        IsHitTestVisible="False"
                        CornerRadius="{DynamicResource PadInnerCornerRadius}">

                    <Grid ColumnDefinitions="Auto,*">

                        <Rectangle x:Name="ProgressFill" Grid.Column="0" VerticalAlignment="Stretch"
                                   Fill="{Binding Category.BackgroundBrush}">
                            <Rectangle.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="100%,0%">
                                     <GradientStop Color="#1400" Offset="0" />
                                     <GradientStop Color="#8000" Offset="1" />
                                     <GradientStop Color="#0000" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.OpacityMask>
                            <Rectangle.Width>
                                <MultiBinding Converter="{StaticResource LerpConverter}">
                                    <Binding Path="Bounds.Width" RelativeSource="{RelativeSource AncestorType=Grid}" />
                                    <Binding Path="Progress" />
                                </MultiBinding>
                            </Rectangle.Width>
                        </Rectangle>

                        <!-- Playhead -->
                        <Rectangle Grid.Column="1" Classes="playhead-layer"
                                   Fill="{Binding Category.BackgroundBrush}" Opacity="0.85"
                                   Effect="{Binding Category.BackgroundBrush, Converter={StaticResource OuterGlowConverter}, ConverterParameter='PlayheadOuter'}" />

                        <Rectangle Grid.Column="1" Classes="playhead-layer"
                                   Fill="{DynamicResource LaserCoreBrush}"
                                   Effect="{Binding Category.BackgroundBrush, Converter={StaticResource OuterGlowConverter}, ConverterParameter='PlayheadInner'}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Playing Border Overlay -->
        <Border Classes="progress"
                Classes.playing="{Binding IsPlaying}"
                IsHitTestVisible="False"
                CornerRadius="{DynamicResource PadOuterCornerRadius}"
                BorderThickness="{DynamicResource PadBorderThickness}"
                BorderBrush="{Binding Category.BackgroundBrush}">
            <Border.OpacityMask>
                <LinearGradientBrush StartPoint="0%,80%" EndPoint="70%,20%">
                    <GradientStop Color="#FF000000" Offset="0" />
                    <GradientStop Color="#00000000" Offset="1" />
                </LinearGradientBrush>
            </Border.OpacityMask>
        </Border>
    </Panel>
</UserControl>