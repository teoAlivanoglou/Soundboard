<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Soundboard.Avalonia.UI.Views"
        xmlns:vm="clr-namespace:Soundboard.Avalonia.ViewModels"
        xmlns:system="clr-namespace:System;assembly=System.Runtime"
        mc:Ignorable="d" d:DesignWidth="1240" d:DesignHeight="720"
        x:Class="Soundboard.Avalonia.MainWindow"
        Title="Soundboard.Avalonia"
        Width="{Binding Settings.ApplicationUiSettings.WindowWidth, Mode=OneTime}"
        Height="{Binding Settings.ApplicationUiSettings.WindowHeight, Mode=OneTime}"
        MinWidth="500"
        MinHeight="400"
        x:Name="RootWindow"
        x:DataType="vm:SoundboardViewModel">

    <Window.Resources>
        <system:Double x:Key="CategoryMaxHeightRatio">0.33</system:Double>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="GridSplitter:pointerover Rectangle">
            <Setter Property="Fill" Value="{DynamicResource AccentFocusBrush}" />
        </Style>
    </Window.Styles>

    <Design.DataContext>
        <vm:SoundboardViewModel />
    </Design.DataContext>

    <!-- Main Workspace: Resizable Sidebar on Left, Content Grid on Right -->
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" MinWidth="160" MaxWidth="500" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <views:CategorySidebarView Grid.Column="0" />

        <!-- Resizer Splitter with 1px border line and 5px hit-test zone -->
        <GridSplitter Grid.Column="1"
                      Width="5"
                      Background="Transparent"
                      Cursor="SizeWestEast"
                      ResizeDirection="Columns">
            <GridSplitter.Template>
                <ControlTemplate>
                    <Border Background="Transparent" Width="5">
                        <Rectangle Width="1"
                                   Fill="{DynamicResource PadBorderBrush}"
                                   HorizontalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <!-- Right Side: Soundboard Grid, Settings Panel, Bottom Bar -->
        <Grid Grid.Column="2" RowDefinitions="*,Auto,Auto">
            <views:SoundboardGridView Grid.Row="0"
                                      BorderThickness="0,0,0,1"
                                      BorderBrush="{DynamicResource PadBorderBrush}" />

            <views:SettingsPanelView Grid.Row="1"
                                     IsVisible="{Binding SettingsVisible}"
                                     BorderThickness="0,0,0,1"
                                     BorderBrush="{DynamicResource PadBorderBrush}" />

            <views:BottomBarView Grid.Row="2" />
        </Grid>
    </Grid>

</Window>