<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Soundboard.Avalonia.UI.Controls">

    <!-- Common / Theme-agnostic brushes -->
    <SolidColorBrush x:Key="StopAllButtonBrush" Color="#FFE11D48" />
    <SolidColorBrush x:Key="StopAllButtonPointerOverBrush" Color="#FFF06575" />
    <SolidColorBrush x:Key="LaserPlayheadBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="LaserCoreBrush" Color="#FFFBE8" />

    <LinearGradientBrush x:Key="ProgressFillOpacityMaskBrush" StartPoint="0,0" EndPoint="100%,0%">
        <GradientStop Color="#1000" Offset="0" />
        <GradientStop Color="#8000" Offset="1" />
        <GradientStop Color="#0000" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PlayingBorderOpacityMaskBrush" StartPoint="0%,80%" EndPoint="70%,20%">
        <GradientStop Color="#FF000000" Offset="0" />
        <GradientStop Color="#00000000" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="TopEdgeFadeOpacityMaskBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#FF000000" Offset="0" />
        <GradientStop Color="#00000000" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BottomEdgeFadeOpacityMaskBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#00000000" Offset="0" />
        <GradientStop Color="#FF000000" Offset="1" />
    </LinearGradientBrush>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFF4F6FA" />
            <SolidColorBrush x:Key="PadSurfaceBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="PadBorderBrush" Color="#FFD8DCE6" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF181B22" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#FF64748B" />
            <SolidColorBrush x:Key="ActionButtonBrush" Color="#FFD4DAE6" />
            <SolidColorBrush x:Key="ActionButtonForeground" Color="#FF0F172A" />

            <!-- Sidebar, Search Box & TreeView (Light) -->
            <SolidColorBrush x:Key="TreeRowPointerOverBrush" Color="#FFE8ECF4" />
            <SolidColorBrush x:Key="TreeRowSelectedBrush" Color="#FFE2E8F5" />
            <SolidColorBrush x:Key="TreeRowSelectedBorderBrush" Color="#FFB8C5DE" />
            <SolidColorBrush x:Key="TreeRowSelectedPointerOverBrush" Color="#FFD9E2F2" />
            <SolidColorBrush x:Key="TreeRowSelectedPointerOverBorderBrush" Color="#FFA6B8D6" />
            <SolidColorBrush x:Key="HeaderButtonPointerOverBrush" Color="#FFC8D1E2" />
            <SolidColorBrush x:Key="HeaderButtonPressedBrush" Color="#FFBDC7DA" />
            <SolidColorBrush x:Key="SearchBoxBackgroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="SearchBoxPointerOverBackgroundBrush" Color="#FFF8FAFC" />
            <SolidColorBrush x:Key="SearchBoxPointerOverBorderBrush" Color="#FFBAC3D6" />
            <SolidColorBrush x:Key="CategoryDisabledLedBrush" Color="#FFCCD2DF" />
            <SolidColorBrush x:Key="AccentFocusBrush" Color="#FF3B82F6" />
            <SolidColorBrush x:Key="TreeRowTextBrush" Color="#FF525E75" />
            <SolidColorBrush x:Key="TreeRowTextHoverBrush" Color="#FF0F172A" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF111318" />
            <SolidColorBrush x:Key="PadSurfaceBrush" Color="#FF1A1D26" />
            <SolidColorBrush x:Key="PadBorderBrush" Color="#FF2B3142" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF1F3F7" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#FF828A9C" />
            <SolidColorBrush x:Key="ActionButtonBrush" Color="#FF202430" />
            <SolidColorBrush x:Key="ActionButtonForeground" Color="#FFE2E8F0" />

            <!-- Sidebar, Search Box & TreeView (Dark) -->
            <SolidColorBrush x:Key="TreeRowPointerOverBrush" Color="#FF161C27" />
            <SolidColorBrush x:Key="TreeRowSelectedBrush" Color="#FF1C2436" />
            <SolidColorBrush x:Key="TreeRowSelectedBorderBrush" Color="#FF293750" />
            <SolidColorBrush x:Key="TreeRowSelectedPointerOverBrush" Color="#FF222C40" />
            <SolidColorBrush x:Key="TreeRowSelectedPointerOverBorderBrush" Color="#FF35486B" />
            <SolidColorBrush x:Key="HeaderButtonPointerOverBrush" Color="#FF242D40" />
            <SolidColorBrush x:Key="HeaderButtonPressedBrush" Color="#FF181E2B" />
            <SolidColorBrush x:Key="SearchBoxBackgroundBrush" Color="#FF141824" />
            <SolidColorBrush x:Key="SearchBoxPointerOverBackgroundBrush" Color="#FF161B28" />
            <SolidColorBrush x:Key="SearchBoxPointerOverBorderBrush" Color="#FF35435C" />
            <SolidColorBrush x:Key="CategoryDisabledLedBrush" Color="#FF232936" />
            <SolidColorBrush x:Key="AccentFocusBrush" Color="#FF4C82FB" />
            <SolidColorBrush x:Key="TreeRowTextBrush" Color="#FFC0CAE0" />
            <SolidColorBrush x:Key="TreeRowTextHoverBrush" Color="#FFFFFFFF" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>