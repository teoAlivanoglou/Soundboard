<Window x:Name="window" x:Class="Soundboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Soundboard"
        xmlns:VM="clr-namespace:Soundboard.ViewModels"
        xmlns:settings="clr-namespace:Soundboard.Settings"
        xmlns:ui="clr-namespace:Soundboard.UI"
        mc:Ignorable="d"
        Title="Soundboard - ΜΑΧΗ FM 99.8 - 1.0" 
        Width="{Binding Settings.ApplicationUiSettings.WindowWidth, Mode=OneTime}" 
        Height="{Binding Settings.ApplicationUiSettings.WindowHeight, Mode=OneTime}"
        d:DataContext="{d:DesignInstance Type=VM:SoundboardViewModel, IsDesignTimeCreatable=True}"
        SizeChanged="WindowResized"
        Closing="WindowClosing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <ListView x:Name="TopTabsPanel" Grid.Row="0"
                  ItemsSource="{Binding Categories}" Margin="5 0 5 -4" BorderThickness="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ItemContainerStyle="{StaticResource NoHoverListViewItem}">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel IsItemsHost="True" Orientation="Horizontal"
                               MaxWidth="{Binding Path=ActualWidth,RelativeSource={RelativeSource AncestorType=ListView}}" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Background="{Binding Path= Category, Converter={StaticResource CategoryColorConverter}}"
                            Style="{StaticResource TopTabsButtonStyle}"
                            IsManipulationEnabled="{Binding Enabled}"
                            Margin="1"
                            MouseDown="TabButtonClick">
                        <TextBlock
                            Text="{Binding Category, Converter={StaticResource NoCategoryConverter}}" />
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>


        <!-- Soundboard Buttons Panel -->

        <ListView x:Name="SoundboardButtonsPanel" Grid.Row="1"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ItemContainerStyle="{StaticResource NoHoverListViewItem}"
                  ItemsSource="{Binding SoundItems}"
                  Margin="0 2 0 0 ">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel VerticalAlignment="Top"

                               HorizontalAlignment="Left" FlowDirection="LeftToRight" Orientation="Horizontal"
                               Width="{Binding ActualWidth, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:MainWindow}}}"
                               IsItemsHost="True" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <!-- Background="{Binding ., Converter={StaticResource CategoryColorConverter}}" -->

                    <Border
                        CornerRadius="8"
                        Height="{Binding RelativeSource={RelativeSource Self}, Path=ActualWidth}"
                        Width="{Binding DataContext.ApplicationUiSettings.ItemWidth, ElementName=SettingsGrid}"
                        Margin="{Binding DataContext.ApplicationUiSettings.ButtonGap, Converter={StaticResource TestConverter}, ElementName=SettingsGrid}"
                        MouseDown="SoundButtonClicked"
                        Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                        Style="{StaticResource SoundButtonsHoverStyle}">
                        <!-- <Border.Background> -->
                        <!--     <DrawingBrush> -->
                        <!--         <DrawingBrush.Drawing> -->
                        <!--             <DrawingGroup> -->
                        <!--                 <GeometryDrawing> -->
                        <!--                     <GeometryDrawing.Geometry> -->
                        <!--                         <RectangleGeometry Rect="0 0 1 1"/> -->
                        <!--                     </GeometryDrawing.Geometry> -->
                        <!--                     <GeometryDrawing.Brush> -->
                        <!--                         <SolidColorBrush Color="{Binding ., Converter={StaticResource CategoryColorConverter}}"/> -->
                        <!--                     </GeometryDrawing.Brush> -->
                        <!--                 </GeometryDrawing> -->
                        <!-- -->
                        <!--                 <GeometryDrawing> -->
                        <!--                     <GeometryDrawing.Geometry> -->
                        <!--                         <RectangleGeometry Rect="0 0 1 1"/> -->
                        <!--                     </GeometryDrawing.Geometry> -->
                        <!--                     <GeometryDrawing.Brush> -->
                        <!--                         <RadialGradientBrush ColorInterpolationMode="ScRgbLinearInterpolation" Center="0.5,0.5" GradientOrigin="0.5,0.5" MappingMode="RelativeToBoundingBox" RadiusX="1" RadiusY="1" SpreadMethod="Pad"> -->
                        <!--                             <GradientStop Color="#ff000000" Offset="1"/> -->
                        <!--                             <GradientStop Color="{Binding ., Converter={StaticResource CategoryColorConverter}}" Offset="0.52"/> -->
                        <!--                             ~1~ <GradientStop Color="{Binding ., Converter={StaticResource CategoryColorConverter}, ConverterParameter='a'}" Offset="0.323"/> @1@ -->
                        <!--                             ~1~ <GradientStop Color="White" Offset="0.16"/> @1@ -->
                        <!--                         </RadialGradientBrush> -->
                        <!--                     </GeometryDrawing.Brush> -->
                        <!--                 </GeometryDrawing> -->
                        <!--             </DrawingGroup> -->
                        <!--         </DrawingBrush.Drawing> -->
                        <!--     </DrawingBrush> -->
                        <!-- </Border.Background> -->


                        <Grid>


                            <Border Background="{StaticResource ProgressButtonFillColor}"
                                    HorizontalAlignment="Left" CornerRadius="8">
                                <Border.Width>
                                    <MultiBinding Converter="{StaticResource LerpConverter}" Mode="OneWay"
                                                  UpdateSourceTrigger="PropertyChanged">
                                        <Binding Path="ActualWidth"
                                                 RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=Border}" />
                                        <Binding Path="Progress" />
                                    </MultiBinding>

                                </Border.Width>

                            </Border>

                            <TextBlock Text="{Binding Name}"
                                       HorizontalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" TextWrapping="Wrap" TextAlignment="Center"
                                       FontSize="14"
                                       Margin="4">
                                <TextBlock.MaxWidth>
                                    <MultiBinding Converter="{StaticResource TextBlockTextWidthConverter}">
                                        <Binding Path="DataContext.ApplicationUiSettings.MinButtonSize"
                                                 ElementName="SettingsGrid" />
                                        <Binding Path="DataContext.ApplicationUiSettings.ButtonGap"
                                                 ElementName="SettingsGrid" />
                                    </MultiBinding>
                                </TextBlock.MaxWidth>
                            </TextBlock>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Settings Panel (almost always hidden) -->

        <Border x:Name="SettingsPanel"
                Grid.Row="2"
                Visibility="{Binding  SettingsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid x:Name="SettingsGrid" DataContext="{x:Static settings:ApplicationSettingsManager.Settings}"
                  Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Column="0" Grid.Row="0" Text="Min Button Size: " />
                <Slider Grid.Column="1" Grid.Row="0" Value="{Binding ApplicationUiSettings.MinButtonSize}"
                        Minimum="50" Maximum="200" ValueChanged="ButtonSizeChanged" />
                <TextBlock Grid.Column="2" Grid.Row="0" Text="{Binding ApplicationUiSettings.MinButtonSize}" />

                <TextBlock Grid.Column="0" Grid.Row="1" Text="Button gap: " />
                <Slider Grid.Column="1" Grid.Row="1" Value="{Binding ApplicationUiSettings.ButtonGap}"
                        Minimum="0" Maximum="20" ValueChanged="ButtonGapChanged" />
                <TextBlock Grid.Column="2" Grid.Row="1" Text="{Binding ApplicationUiSettings.ButtonGap}" />

                <TextBlock Grid.Column="0" Grid.Row="2" Text="Max Folder Level: " />
                <Slider Grid.Column="1" Grid.Row="2"
                        Value="{Binding ApplicationUiSettings.MaxFolderLevel}"
                        Minimum="0" Maximum="5" />
                <TextBlock Grid.Column="2" Grid.Row="2" Text="{Binding ApplicationUiSettings.MaxFolderLevel}" />

                <TextBlock Grid.Column="0" Grid.Row="3" Text="Fade In Time: " />
                <Slider Grid.Column="1" Grid.Row="3" Value="{Binding AudioPlayerSettings.FadeInTime}"
                        Minimum="0" Maximum="1000" />
                <TextBlock Grid.Column="2" Grid.Row="3" Text="{Binding AudioPlayerSettings.FadeInTime}" />


                <TextBlock Grid.Column="0" Grid.Row="4" Text="Audio driver: " />
                <ComboBox Grid.Column="1" Grid.Row="4"
                          ItemsSource="{Binding AudioPlayerSettings.DriverType, Converter={local:EnumToCollectionConverter}, Mode=OneTime}"
                          SelectedValuePath="Value"
                          DisplayMemberPath="Description"
                          SelectedValue="{Binding AudioPlayerSettings.DriverType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="2" Grid.Row="4" Grid.RowSpan="2" Content="Reset Audio Driver" Margin="5"
                        Click="ResetAudioDriverButtonClicked" />


                <TextBlock Grid.Column="0" Grid.Row="5" Text="Sample rate: " />
                <ComboBox Grid.Column="1" Grid.Row="5"
                          ItemsSource="{Binding AudioPlayerSettings.SampleRate, Converter={local:EnumToCollectionConverter}, Mode=OneTime}"
                          SelectedValuePath="Value"
                          DisplayMemberPath="Description"
                          SelectedValue="{Binding AudioPlayerSettings.SampleRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Column="0" Grid.Row="6" Text="Latency: " />
                <Slider Grid.Column="1" Grid.Row="6"
                        Value="{Binding AudioPlayerSettings.Latency, Converter={StaticResource LogScaleConverter}}"
                        Minimum="0" Maximum="1" IsMoveToPointEnabled="True" />
                <TextBlock Grid.Column="2" Grid.Row="6" Text="{Binding AudioPlayerSettings.Latency}" />
            </Grid>
        </Border>


        <!-- Footer Buttons Panel -->

        <Grid x:Name="FooterButtonsPanel"
              Grid.Row="3">
            <Grid.Resources>
                <Style TargetType="Border" BasedOn="{StaticResource FlatButtonStyle}" />
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" MouseDown="StopAllClicked" Background="{StaticResource RedButtonBackground}">
                <TextBlock Text="Stop All" Foreground="{StaticResource RedButtonForeground}" FontWeight="SemiBold"
                           FontSize="14" />
            </Border>

            <Border Grid.Column="4" MouseDown="BrowseFolderClicked">
                <TextBlock Text="" FontFamily="Segoe MDL2 Assets" />
            </Border>

            <Border Grid.Column="5" MouseDown="RefreshClicked">
                <TextBlock Text="" FontFamily="Segoe MDL2 Assets" />
            </Border>

            <Border Grid.Column="6" MouseDown="SettingsClicked"
                    Visibility="{Binding SettingsButtonVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="" FontFamily="Segoe MDL2 Assets" />
            </Border>

            <Border Grid.Column="6" MouseDown="SettingsClicked">
                <TextBlock Text="" FontFamily="Segoe MDL2 Assets" />
            </Border>

        </Grid>
    </Grid>
</Window>