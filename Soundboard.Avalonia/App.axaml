<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Soundboard.Avalonia.UI.Converters"
             x:Class="Soundboard.Avalonia.App"
             RequestedThemeVariant="Default">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Styles>
        <FluentTheme />

    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/UI/Themes/Dimensions.axaml" />
                <ResourceInclude Source="/UI/Themes/Colors.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <FontFamily x:Key="IconFont">avares://Soundboard.Avalonia/UI/Fonts/lucide.ttf#lucide</FontFamily>
            <converters:ShadowConverter x:Key="ShadowConverter" />
            <converters:OuterGlowConverter x:Key="OuterGlowConverter" />
            <converters:LerpConverter x:Key="LerpConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>