<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>SonicPad</RootNamespace>
		<AssemblyName>SonicPad</AssemblyName>
		<OutputType>WinExe</OutputType>
		<ApplicationIcon>Assets\sonicpad.ico</ApplicationIcon>
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0-windows7.0</TargetFramework>
    <TargetFramework Condition="!$([MSBuild]::IsOSPlatform('Windows'))">net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ApplicationManifest Condition="$([MSBuild]::IsOSPlatform('Windows'))">app.manifest</ApplicationManifest>
		<Platforms>AnyCPU;x64;x86;ARM64</Platforms>
		<PlatformTarget Condition="!$([MSBuild]::IsOSPlatform('Windows'))">AnyCPU</PlatformTarget>
	</PropertyGroup>
	<PropertyGroup Label="Avalonia">
		<AvaloniaNameGeneratorDefaultFieldModifier>Public</AvaloniaNameGeneratorDefaultFieldModifier>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
	</PropertyGroup>

	<PropertyGroup Condition="'$(PublishAot)' == 'true'">
		<DebugSymbols>false</DebugSymbols>
		<DebugType>none</DebugType>
		<StripSymbols>true</StripSymbols>
		<OptimizationPreference Condition="'$(OptimizationPreference)' == ''">Speed</OptimizationPreference>
		<IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
		<IlcGenerateCompleteTypeMetadata>false</IlcGenerateCompleteTypeMetadata>
		<EventSourceSupport>false</EventSourceSupport>
		<UseSystemResourceKeys>true</UseSystemResourceKeys>
		<HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
		<DebuggerSupport>false</DebuggerSupport>
		<StackTraceSupport>false</StackTraceSupport>
	</PropertyGroup>

	<!-- Exclude any 3rd-party .pdb files (e.g. libSkiaSharp.pdb, libHarfBuzzSharp.pdb) from publish output -->
	<Target Name="RemovePdbFromPublish" AfterTargets="ComputeFilesToPublish">
		<ItemGroup>
			<ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
		</ItemGroup>
	</Target>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.1.2" />
		<PackageReference Include="Avalonia.Controls.ItemsRepeater" Version="12.0.0" />
		<PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
		<PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
			<IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
			<PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
		</PackageReference>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
		<PackageReference Include="NAudio" Version="3.1.0" />
		<PackageReference Include="NAudio.SoundFile" Version="3.1.0" />
	</ItemGroup>

	<ItemGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
		<PackageReference Include="NAudio.MacOS" Version="3.1.1-preview.2" />
	</ItemGroup>


	<ItemGroup>
		<AvaloniaResource Include="UI\Fonts\lucide.ttf" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="Assets\warning.mp3" />
	</ItemGroup>

	<ItemGroup>
		<AvaloniaResource Include="Assets\warning.mp3" />
		<AvaloniaResource Include="Assets\sonicpad.ico" />
	</ItemGroup>

	<ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
		<Content Include="Native\sndfile.dll" TargetPath="sndfile.dll">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
		<Content Include="Native\libsndfile.dylib" TargetPath="libsndfile.dylib">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX')) and '$(PublishAot)' == ''">
		<PublishAot>true</PublishAot>
	</PropertyGroup>

	<!-- Automatically assemble macOS .app bundle on macOS publish -->
	<Target Name="CreateMacAppBundle" AfterTargets="Publish;CopyNativeBinary" Condition="$([MSBuild]::IsOSPlatform('OSX')) or $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('osx'))">
		<PropertyGroup>
			<AppBundlePublishDir Condition="'$(PublishDir)' != ''">$([System.IO.Path]::GetFullPath('$(PublishDir)'))</AppBundlePublishDir>
			<AppBundlePublishDir>$([MSBuild]::EnsureTrailingSlash('$(AppBundlePublishDir)'))</AppBundlePublishDir>
			<AppBundleDir>$(AppBundlePublishDir)SonicPad.app</AppBundleDir>
			<AppBundleContents>$(AppBundleDir)/Contents</AppBundleContents>
			<AppBundleMacOS>$(AppBundleContents)/MacOS</AppBundleMacOS>
			<AppBundleResources>$(AppBundleContents)/Resources</AppBundleResources>
		</PropertyGroup>
		<Message Importance="high" Text="==&gt; Creating macOS application bundle: $(AppBundleDir)" />
		<RemoveDir Directories="$(AppBundleDir)" />
		<MakeDir Directories="$(AppBundleMacOS);$(AppBundleResources)" />
		<Copy SourceFiles="$(MSBuildProjectDirectory)/Info.plist" DestinationFolder="$(AppBundleContents)" Condition="Exists('$(MSBuildProjectDirectory)/Info.plist')" />
		<!-- Copy native dependencies and published files -->
		<Exec Command="find &quot;$(AppBundlePublishDir)&quot; -maxdepth 1 -type f ! -name &quot;.*&quot; -exec cp -f {} &quot;$(AppBundleMacOS)/&quot; \;" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
		<!-- Ensure the genuine Native AOT executable is copied, prioritizing $(NativeBinary) if present -->
		<Exec Command="if [ -n &quot;$(NativeBinary)&quot; ] &amp;&amp; [ -f &quot;$(NativeBinary)&quot; ]; then cp -f &quot;$(NativeBinary)&quot; &quot;$(AppBundleMacOS)/SonicPad&quot;; fi &amp;&amp; chmod +x &quot;$(AppBundleMacOS)/SonicPad&quot;" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
		<Exec Command="which codesign &gt;/dev/null 2&gt;&amp;1 &amp;&amp; codesign --force --deep --sign - &quot;$(AppBundleDir)&quot; || true" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
		<Message Importance="high" Text="==&gt; Successfully created macOS application bundle: $(AppBundleDir)" />
	</Target>
</Project>
