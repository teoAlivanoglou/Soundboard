<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Soundboard.Avalonia.UI.Controls"
        xmlns:avalonia="clr-namespace:Soundboard.Avalonia"
        xmlns:ui="clr-namespace:Soundboard.Avalonia.UI" 
        xmlns:views="clr-namespace:Soundboard.Avalonia.UI.Views"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Soundboard.Avalonia.MainWindow"
        Title="Soundboard.Avalonia" 
        x:DataType="avalonia:TestViewModel">
    
    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto" ClipToBounds="False" Background="{DynamicResource WindowBackgroundBrush}">

        <views:CategoryBarView Grid.Row="0"/>
        <views:SoundboardGridView Grid.Row="1"/>
        <!-- <views:SettingsPanelView Grid.Row="2"/> -->

        <!-- <Slider Grid.Row="2" Margin="24,10" Minimum="100" Maximum="300" Value="{Binding Model.Size, Mode=TwoWay}"/> -->
        <views:BottomBarView Grid.Row="3"/>

    </Grid>
    
</Window>
