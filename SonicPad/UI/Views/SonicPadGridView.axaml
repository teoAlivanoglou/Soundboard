<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:SonicPad.UI.Controls"
             xmlns:discovery="clr-namespace:SonicPad.Discovery"
             xmlns:vm="clr-namespace:SonicPad.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SonicPad.UI.Views.SonicPadGridView"
             x:DataType="vm:SonicPadViewModel"
             ClipToBounds="False">
    <Design.DataContext>
        <vm:SonicPadViewModel />
    </Design.DataContext>
    <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Padding="16, 12"
                      ClipToBounds="False">


            <ItemsRepeater ItemsSource="{Binding VisibleSoundItems}" ClipToBounds="False">
                <ItemsRepeater.Layout>
                    <UniformGridLayout Orientation="Horizontal"
                                       MinItemWidth="{Binding Settings.ApplicationUiSettings.MinButtonSize}"
                                       MinItemHeight="{Binding Settings.ApplicationUiSettings.MinButtonSize}"
                                       MinColumnSpacing="{Binding Settings.ApplicationUiSettings.ButtonGap}"
                                       MinRowSpacing="{Binding Settings.ApplicationUiSettings.ButtonGap}"
                                       ItemsStretch="Uniform"/>
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate DataType="discovery:SoundModel">
                        <controls:FastSoundPad ClipToBounds="False"/>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

        </ScrollViewer>

        <!-- Top edge fade shadow -->
        <Border Height="{StaticResource ViewEdgeFadeHeight}"
                VerticalAlignment="Top"
                IsHitTestVisible="False"
                Background="{DynamicResource WindowBackgroundBrush}"
                OpacityMask="{StaticResource TopEdgeFadeOpacityMaskBrush}" />

        <!-- Bottom edge fade shadow -->
        <Border Height="{StaticResource ViewEdgeFadeHeight}"
                VerticalAlignment="Bottom"
                IsHitTestVisible="False"
                Background="{DynamicResource WindowBackgroundBrush}"
                OpacityMask="{StaticResource BottomEdgeFadeOpacityMaskBrush}" />
    </Grid>
</UserControl>
