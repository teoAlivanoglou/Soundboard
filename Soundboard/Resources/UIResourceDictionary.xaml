<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="GreyButtonBackground" Color="#FFCAC8D6"/>
    <SolidColorBrush x:Key="GreyButtonForeground" Color="Black"/>

    <SolidColorBrush x:Key="RedButtonBackground" Color="#FFE8ABAB"/>
    <SolidColorBrush x:Key="RedButtonForeground" Color="#FF541E1E"/>

    <SolidColorBrush x:Key="ProgressButtonFillColor" Color="#FF64FF64"/>
    <SolidColorBrush x:Key="EnabledBrushColor" Color="#FF18737F"/>


    <Style TargetType="Border" x:Key="FlatButtonStyle">
        <Setter Property="Padding" Value="8 4" />
        <Setter Property="Background" Value="{StaticResource GreyButtonBackground}" />
        <Setter Property="Margin" Value="4"/>
        <Style.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="Foreground" Value="{StaticResource GreyButtonForeground}"/>
            </Style>
        </Style.Resources>
    </Style>

    <Style TargetType="Slider">
        <Setter Property="Margin" Value="0 2 0 2"></Setter>
    </Style>
    <Style TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
</ResourceDictionary>