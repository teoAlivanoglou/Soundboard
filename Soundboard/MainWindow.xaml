<Window x:Class="Soundboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Soundboard"
        xmlns:VM="clr-namespace:Soundboard.ViewModels"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="400"
        d:DataContext="{d:DesignInstance Type=VM:SoundboardViewModel, IsDesignTimeCreatable=True}"
        SizeChanged="WindowResized"
        >
    <Window.Resources>
        <local:TestConverter x:Key="TestConverter"/>
        <local:MultiTestConverter x:Key="MultiTestConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ListView x:Name="SoundboardButtons" Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="4" Grid.RowSpan="2" ItemsSource="{Binding SoundItems}">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid VerticalAlignment="Top" Columns="{Binding Columns}"  HorizontalAlignment="Stretch" IsItemsHost="True" SizeChanged="UniformGrid_SizeChanged"/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Button Name="Poutsos"
                            Content="{Binding Name}" 
                            Height="{Binding RelativeSource={RelativeSource Self}, Path=ActualWidth}"/>

                </DataTemplate>
            </ListView.ItemTemplate>
            

            

        </ListView>

        <StackPanel Orientation="Vertical" Grid.ColumnSpan="4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Min Button Size: "/>
                <TextBox Text="{Binding MinButtonSize}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Extra Gap: "/>
                <TextBox Text="{Binding ExtraGap}"/>
            </StackPanel>
        </StackPanel>

        <!--UniformGrid Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="4" Grid.RowSpan="3"  Columns="4" VerticalAlignment="Top">
            <UniformGrid.Resources>
                <Style TargetType="Button">
                    <Setter Property="Height" Value="{Binding RelativeSource={RelativeSource Self}, Path=ActualWidth}" />
                    <Setter Property="Margin" Value="6" />
                </Style>
            </UniformGrid.Resources>

            <Button Content="Button"/>
            <Button Content="Button"/>
            <Button Content="Button"/>
            <Button Content="Button"/>
            <Button Content="Button"/>
            <Button Content="Button"/>
        </UniformGrid-->

    </Grid>
</Window>
