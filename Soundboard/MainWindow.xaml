<Window x:Name="window" x:Class="Soundboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Soundboard"
        xmlns:VM="clr-namespace:Soundboard.ViewModels"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="402"
        d:DataContext="{d:DesignInstance Type=VM:SoundboardViewModel, IsDesignTimeCreatable=True}"
        SizeChanged="WindowResized"
        >
    <Window.Resources>
        <local:TestConverter x:Key="TestConverter"/>
        <local:MultiTestConverter x:Key="MultiTestConverter"/>
        <local:MultByTenConverter x:Key="MultByTenConverter"/>


    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <ListView x:Name="SoundboardButtons" Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="4" Grid.RowSpan="1" ItemsSource="{Binding SoundItems}">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid VerticalAlignment="Top" Columns="{Binding Columns}"  HorizontalAlignment="Stretch" IsItemsHost="True" SizeChanged="UniformGrid_SizeChanged"/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Focusable" Value="False"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Background="#FFCAC8D6"
                            Height="{Binding RelativeSource={RelativeSource Self}, Path=ActualWidth}" 
                            Margin="{Binding DataContext.ButtonGap, Converter={StaticResource TestConverter}, ElementName=window}">
                        <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>


                </DataTemplate>
            </ListView.ItemTemplate>




        </ListView>

        <StackPanel Orientation="Vertical" Grid.ColumnSpan="4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Min Button Size: "/>
                <Slider Value="{Binding MinButtonSize}" 
                        Minimum="50" Maximum="200" Width="100" TickFrequency="1" TickPlacement="BottomRight"
                        ValueChanged="ButtonSizeChanged"/>
                <TextBlock Text="{Binding MinButtonSize}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Button gap: "/>
                <Slider Value="{Binding ButtonGap}" 
                        Minimum="0" Maximum="20" Width="100" TickFrequency="1" TickPlacement="BottomRight"
                        ValueChanged="ButtonGapChanged"/>
                <TextBlock Text="{Binding ButtonGap}"/>
            </StackPanel>

        </StackPanel>

        <!--UniformGrid Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="4" Grid.RowSpan="3"  Columns="4" VerticalAlignment="Top">
            <UniformGrid.Resources>
                <Style TargetType="Button">
                    <Setter Property="Height" Value="{Binding RelativeSource={RelativeSource Self}, Path=ActualWidth}" />
                    <Setter Property="Margin" Value="6" />
                </Style>
            </UniformGrid.Resources>

            <Button Content="Button"/>
            <Button Content="Button"/>
            <Button Content="Button"/>
            <Button Content="Button"/>
            <Button Content="Button"/>
            <Button Content="Button"/>
        </UniformGrid-->

    </Grid>
</Window>
