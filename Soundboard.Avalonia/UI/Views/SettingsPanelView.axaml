<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Soundboard.Avalonia.ViewModels"
             xmlns:audioEngine="clr-namespace:Soundboard.Avalonia.AudioEngine"
             xmlns:converters="clr-namespace:Soundboard.Avalonia.UI.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Soundboard.Avalonia.UI.Views.SettingsPanelView"
             x:DataType="vm:SoundboardViewModel">

    <Design.DataContext>
        <vm:SoundboardViewModel />
    </Design.DataContext>

    <UserControl.Resources>
        <converters:DoubleToIntConverter x:Key="DoubleToIntConverter" />
        <converters:EnumDescriptionConverter x:Key="EnumDescriptionConverter" />
    </UserControl.Resources>

    <Border x:Name="SettingsPanel"
            Background="{DynamicResource WindowBackgroundBrush}"
            Padding="16, 12">
        <Grid x:Name="SettingsGrid"
              ColumnDefinitions="Auto,*,Auto"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
            <Grid.Styles>
                <Style Selector="TextBlock.label">
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Margin" Value="0, 4, 16, 4" />
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                </Style>
                <Style Selector="TextBlock.value">
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="HorizontalAlignment" Value="Right" />
                    <Setter Property="Margin" Value="12, 4, 0, 4" />
                    <Setter Property="Width" Value="56" />
                    <Setter Property="TextAlignment" Value="End" />
                    <Setter Property="FontFeatures" Value="tnum" />
                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                </Style>
                <Style Selector="Slider">
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Margin" Value="0, 2" />
                </Style>
                <Style Selector="ComboBox">
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Margin" Value="0, 2" />
                </Style>
            </Grid.Styles>

            <!-- Min Button Size -->
            <TextBlock Grid.Column="0" Grid.Row="0" Classes="label" Text="Min Button Size: " />
            <Slider Grid.Column="1" Grid.Row="0"
                    Value="{Binding Settings.ApplicationUiSettings.MinButtonSize, Converter={StaticResource DoubleToIntConverter}}"
                    Minimum="50" Maximum="300"
                    TickFrequency="1" IsSnapToTickEnabled="True" />
            <TextBlock Grid.Column="2" Grid.Row="0" Classes="value"
                       Text="{Binding Settings.ApplicationUiSettings.MinButtonSize, StringFormat='{}{0}px'}" />

            <!-- Button Gap -->
            <TextBlock Grid.Column="0" Grid.Row="1" Classes="label" Text="Button Gap: " />
            <Slider Grid.Column="1" Grid.Row="1"
                    Value="{Binding Settings.ApplicationUiSettings.ButtonGap, Converter={StaticResource DoubleToIntConverter}}"
                    Minimum="0" Maximum="30"
                    TickFrequency="1" IsSnapToTickEnabled="True" />
            <TextBlock Grid.Column="2" Grid.Row="1" Classes="value"
                       Text="{Binding Settings.ApplicationUiSettings.ButtonGap, StringFormat='{}{0}px'}" />

            <!-- Max Folder Level -->
            <TextBlock Grid.Column="0" Grid.Row="2" Classes="label" Text="Max Folder Level: " />
            <Slider Grid.Column="1" Grid.Row="2"
                    Value="{Binding Settings.ApplicationUiSettings.MaxFolderLevel, Converter={StaticResource DoubleToIntConverter}}"
                    Minimum="1" Maximum="10"
                    TickFrequency="1" IsSnapToTickEnabled="True" />
            <TextBlock Grid.Column="2" Grid.Row="2" Classes="value"
                       Text="{Binding Settings.ApplicationUiSettings.MaxFolderLevel}" />

            <!-- Fade In Time -->
            <TextBlock Grid.Column="0" Grid.Row="3" Classes="label" Text="Fade In Time: "
                       IsVisible="{Binding Settings.AudioPlayerSettings.Show}" />
            <Slider Grid.Column="1" Grid.Row="3"
                    Value="{Binding Settings.AudioPlayerSettings.FadeInTime, Converter={StaticResource DoubleToIntConverter}}"
                    Minimum="0" Maximum="1000"
                    TickFrequency="10" IsSnapToTickEnabled="True"
                    IsVisible="{Binding Settings.AudioPlayerSettings.Show}" />
            <TextBlock Grid.Column="2" Grid.Row="3" Classes="value"
                       Text="{Binding Settings.AudioPlayerSettings.FadeInTime, StringFormat='{}{0}ms'}"
                       IsVisible="{Binding Settings.AudioPlayerSettings.Show}" />


            <!-- Latency -->
            <TextBlock Grid.Column="0" Grid.Row="4" Classes="label" Text="Latency: "
                       IsVisible="{Binding Settings.AudioPlayerSettings.Show}" />
            <Slider Grid.Column="1" Grid.Row="4"
                    Value="{Binding Settings.AudioPlayerSettings.Latency}"
                    Minimum="5" Maximum="200"
                    TickFrequency="1" IsSnapToTickEnabled="True"
                    IsVisible="{Binding Settings.AudioPlayerSettings.Show}" />
            <TextBlock Grid.Column="2" Grid.Row="4" Classes="value"
                       Text="{Binding Settings.AudioPlayerSettings.Latency, StringFormat='{}{0:0}ms'}"
                       IsVisible="{Binding Settings.AudioPlayerSettings.Show}" />

            <!-- Audio Driver -->
            <Grid Grid.Column="0" Grid.Row="5" Grid.ColumnSpan="3"
                  ColumnDefinitions="Auto,*,Auto,*,Auto">

                <TextBlock Grid.Column="0"
                           Classes="label" Text="Audio Driver: "
                           IsVisible="{Binding Settings.AudioPlayerSettings.Show}" />
                <ComboBox Grid.Column="1"
                          Margin="0, 0, 24, 0"
                          ItemsSource="{Binding AvailableDriverTypes}"
                          SelectedItem="{Binding Settings.AudioPlayerSettings.DriverType}"
                          IsVisible="{Binding Settings.AudioPlayerSettings.Show}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="audioEngine:DriverType">
                            <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Sample Rate -->
                <TextBlock Grid.Column="2" Classes="label" Text="Sample Rate: "
                           IsVisible="{Binding Settings.AudioPlayerSettings.Show}" />
                <ComboBox Grid.Column="3"
                          Margin="0, 0, 12, 0"
                          ItemsSource="{Binding AvailableSampleRates}"
                          SelectedItem="{Binding Settings.AudioPlayerSettings.SampleRate}"
                          IsVisible="{Binding Settings.AudioPlayerSettings.Show}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="audioEngine:SampleRate">
                            <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Button Grid.Column="4"
                        Content="Reset Driver" Margin="12, 2, 0, 2"
                        VerticalAlignment="Center"
                        Background="{DynamicResource ActionButtonBrush}"
                        Foreground="{DynamicResource ActionButtonForeground}"
                        Command="{Binding ResetAudioDriverCommand}"
                        Click="ResetAudioDriverButtonClicked"
                        IsVisible="{Binding Settings.AudioPlayerSettings.Show}" />


            </Grid>

        </Grid>
    </Border>
</UserControl>