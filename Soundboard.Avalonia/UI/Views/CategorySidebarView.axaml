<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Soundboard.Avalonia.ViewModels"
             xmlns:discovery="clr-namespace:Soundboard.Avalonia.Discovery"
             mc:Ignorable="d" d:DesignWidth="350" d:DesignHeight="600"
             x:Class="Soundboard.Avalonia.UI.Views.CategorySidebarView"
             x:DataType="vm:SoundboardViewModel"
             Background="{DynamicResource WindowBackgroundBrush}">

    <Design.DataContext>
        <vm:SoundboardViewModel />
    </Design.DataContext>

    <UserControl.Resources>
        <!-- Compact TreeView metrics -->
        <x:Double x:Key="TreeViewItemIndent">12</x:Double>
        <x:Double x:Key="TreeViewItemExpandCollapseChevronSize">14</x:Double>
        <Thickness x:Key="TreeViewItemExpandCollapseChevronMargin">2,0,4,0</Thickness>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Mini Header Text Buttons (All, None) -->
        <Style Selector="Button.SidebarHeaderButton">
            <Setter Property="Height" Value="24" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="7, 0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="{DynamicResource ActionButtonBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PadBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.SidebarHeaderButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HeaderButtonPointerOverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentFocusBrush}" />
        </Style>
        <Style Selector="Button.SidebarHeaderButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HeaderButtonPressedBrush}" />
        </Style>

        <!-- Mini Header Icon Buttons (Expand All, Collapse All) -->
        <Style Selector="Button.SidebarHeaderIconButton">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="MinWidth" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="{DynamicResource ActionButtonBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PadBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.SidebarHeaderIconButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HeaderButtonPointerOverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentFocusBrush}" />
        </Style>
        <Style Selector="Button.SidebarHeaderIconButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HeaderButtonPressedBrush}" />
        </Style>

        <!-- Compact Search Box -->
        <Style Selector="TextBox.SidebarSearchBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8, 0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource SearchBoxBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PadBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="TextBox.SidebarSearchBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource SearchBoxPointerOverBorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource SearchBoxPointerOverBackgroundBrush}" />
        </Style>
        <Style Selector="TextBox.SidebarSearchBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentFocusBrush}" />
            <Setter Property="Background" Value="{DynamicResource SearchBoxPointerOverBackgroundBrush}" />
        </Style>

        <!-- TreeViewItem Row Base Metrics -->
        <Style Selector="TreeViewItem">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0, 1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="TreeViewItem /template/ Border#PART_LayoutRoot">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Margin" Value="4, 0" />
        </Style>
        <Style Selector="TreeViewItem /template/ Panel#PART_ExpandCollapseChevronContainer">
            <Setter Property="Margin" Value="2, 0, 4, 0" />
            <Setter Property="Width" Value="14" />
        </Style>

        <!-- Custom Chevron with Lucide IconFont (Right = E06F, Down = E06D) -->
        <Style Selector="TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template">
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent"
                            Width="{TemplateBinding Width}"
                            Height="{TemplateBinding Height}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="ChevronGlyph"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="10"
                                   Text="&#xE06F;"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron:checked /template/ TextBlock#ChevronGlyph">
            <Setter Property="Text" Value="&#xE06D;" />
        </Style>
        <Style Selector="TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron:pointerover /template/ TextBlock#ChevronGlyph">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <!-- TreeViewItem Row Hover State -->
        <Style Selector="TreeViewItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource TreeRowPointerOverBrush}" />
        </Style>

        <!-- Remove TreeViewItem Selection Effect completely (Transparent background, no border) -->
        <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TreeViewItem:selected:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource TreeRowPointerOverBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot > ContentPresenter#PART_HeaderPresenter">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <!-- Category Row Enabled/Disabled Styles & Transitions -->
        <Style Selector="Grid.category-row">
            <Setter Property="Opacity" Value="1.0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border.cat-led-bar" x:DataType="discovery:CategoryModel">
            <Setter Property="Background" Value="{Binding BackgroundBrush}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <!-- Category Name Style (Dimmer in idle, pure white on hover) -->
        <Style Selector="TextBlock.cat-name">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TreeRowTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>

        <!-- Hover State on TreeViewItem: Name brightens to pure white (Dark) / deep black (Light) -->
        <Style Selector="TreeViewItem:pointerover TextBlock.cat-name">
            <Setter Property="Foreground" Value="{DynamicResource TreeRowTextHoverBrush}" />
        </Style>

        <!-- Category Sound Count Badge Style -->
        <Style Selector="TextBlock.cat-count">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFeatures" Value="tnum" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0, 0, 6, 0" />
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>

        <!-- Hover State on TreeViewItem: Count badge brightens slightly when enabled -->
        <Style Selector="TreeViewItem:pointerover TextBlock.cat-count">
            <Setter Property="Opacity" Value="1.0" />
        </Style>

        <!-- Disabled Category: Decoration (LED), text (name), and count ALL share the exact same color and uniform opacity -->
        <Style Selector="Grid.category-row.disabled">
            <Setter Property="Opacity" Value="0.35" />
        </Style>
        <Style Selector="Grid.category-row.disabled Border.cat-led-bar">
            <Setter Property="Background" Value="{DynamicResource TextMutedBrush}" />
        </Style>
        <Style Selector="Grid.category-row.disabled TextBlock.cat-name">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>
        <Style Selector="Grid.category-row.disabled TextBlock.cat-count">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="Opacity" Value="1.0" />
        </Style>
        <!-- Ensure disabled items never turn white on hover -->
        <Style Selector="TreeViewItem:pointerover Grid.category-row.disabled TextBlock.cat-name">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Top Section -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto,Auto,Auto,Auto"
              ColumnSpacing="4"
              VerticalAlignment="Center"
              Margin="12, 8">

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="CATEGORIES"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       LetterSpacing="0.6" />

            <Button Grid.Column="1"
                    Classes="SidebarHeaderButton"
                    Click="OnSelectAllClick"
                    Content="All" />
            <Button Grid.Column="2"
                    Classes="SidebarHeaderButton"
                    Click="OnSelectNoneClick"
                    Content="None" />
            <Button Grid.Column="3"
                    Classes="SidebarHeaderIconButton"
                    Click="OnExpandAllClick"
                    ToolTip.Tip="Expand All"
                    Content="&#xE696;" />
            <Button Grid.Column="4"
                    Classes="SidebarHeaderIconButton"
                    Click="OnCollapseAllClick"
                    ToolTip.Tip="Collapse All"
                    Content="&#xE694;" />
        </Grid>

        <!-- SearchBar -->
        <Border Grid.Row="1"
                BorderThickness="0,1"
                Padding="12, 8"
                BorderBrush="{DynamicResource PadBorderBrush}">

            <TextBox x:Name="CategoryFilterTextBox"
                     PlaceholderText="Filter categories…"
                     Classes="SidebarSearchBox" />
        </Border>

        <!-- Category Tree View -->
        <TreeView Grid.Row="2"
                  ItemsSource="{Binding Categories}"
                  Background="Transparent"
                  BorderThickness="0"
                  Padding="4, 6">
            <TreeView.ItemTemplate>
                <DataTemplate DataType="discovery:CategoryModel">
                    <Grid Classes="category-row"
                          Classes.disabled="{Binding !IsEnabled}"
                          ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8"
                          VerticalAlignment="Center"
                          Background="Transparent"
                          Cursor="Hand"
                          PointerPressed="OnCategoryRowPointerPressed">

                        <!-- LED Accent Bar (Style D - uncolored when disabled) -->
                        <Border Classes="cat-led-bar"
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Height="14" Width="3"
                                CornerRadius="1.5" />
                        
                        <!-- Category Name -->
                        <TextBlock Classes="cat-name"
                                   Grid.Column="1"
                                   Text="{Binding Name}" />
                        
                        <!-- Sound Count Badge -->
                        <TextBlock Classes="cat-count"
                                   Grid.Column="2"
                                   Text="{Binding SoundCount}" />
                    </Grid>
                </DataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

    </Grid>

</UserControl>